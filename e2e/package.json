{
  "name": "@aws/threat-composer-e2e",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Playwright end-to-end / functional tests for the threat-composer web app. Kept outside packages/* so the app's Vitest config (which globs src/**/*.{spec,test}.{ts,tsx}) never tries to run these specs.",
  "type": "module",
  "scripts": {
    "postinstall": "playwright install chromium",
    "test": "playwright test",
    "test:dev": "playwright test",
    "test:preview": "playwright test --config=playwright.preview.config.ts",
    "test:variants": "playwright test --config=playwright.variants.config.ts",
    "test:extension": "playwright test --config=playwright.extension.config.ts",
    "test:all": "playwright test && playwright test --config=playwright.preview.config.ts && playwright test --config=playwright.variants.config.ts && playwright test --config=playwright.extension.config.ts",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:ui:preview": "playwright test --config=playwright.preview.config.ts --ui",
    "test:ui:variants": "playwright test --config=playwright.variants.config.ts --ui",
    "test:ui:extension": "playwright test --config=playwright.extension.config.ts --ui",
    "test:debug": "playwright test --debug",
    "test:trace": "TC_CAPTURE=1 playwright test",
    "trace": "playwright show-trace",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@cloudscape-design/components": "3.0.1352",
    "@playwright/test": "1.62.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
