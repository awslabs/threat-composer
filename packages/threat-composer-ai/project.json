{
  "name": "threat-composer-ai",
  "root": "packages/threat-composer-ai",
  "targets": {
    "install": {
      "dependsOn": [
        "^install"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task install",
        "cwd": "packages/threat-composer-ai"
      }
    },
    "pre-compile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task pre-compile",
        "cwd": "packages/threat-composer-ai"
      }
    },
    "compile": {
      "executor": "nx:run-commands",
      "options": {
