{
  "name": "threat-composer-ai",
  "root": "packages/threat-composer-ai",
  "sourceRoot": "packages/threat-composer-ai/src",
  "projectType": "library",
  "targets": {
    "install": {
      "command": "uv sync",
      "options": {
        "cwd": "packages/threat-composer-ai"
      },
      "cache": false
    },
    "lint": {
      "command": "uv run ruff check . && uv run ruff format --check .",
      "options": {
        "cwd": "packages/threat-composer-ai"
      },
      "dependsOn": [
        "install"
      ]
    },
    "lint:fix": {
      "command": "uv run ruff check --fix . && uv run ruff format .",
      "options": {
        "cwd": "packages/threat-composer-ai"
      },
      "dependsOn": [
        "install"
      ],
      "cache": false
    },
    "test": {
      "command": "uv run pytest tests/",
      "options": {
        "cwd": "packages/threat-composer-ai"
      },
      "dependsOn": [
        "install"
      ],
      "outputs": []
    },
    "build": {
      "executor": "nx:noop",
      "dependsOn": [
        "install",
        "lint",
        "test"
      ]
    }
  }
}
