{
  "name": "@aws/threat-composer-app",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf build coverage test-reports dev-dist",
    "dev": "vite",
    "preview": "vite preview",
    "compile:website": "vite build",
    "compile:browser-extension": "vite build --mode browser-extension",
    "compile:ide-extension": "vite build --mode ide-extension",
    "compile": "yarn compile:website && yarn compile:browser-extension && yarn compile:ide-extension",
    "post-compile": "mkdir -p ./build/storybook && cp -r ../threat-composer/storybook.out/. ./build/storybook/",
    "build": "yarn compile && yarn post-compile && yarn test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "eslint": "eslint --ext .ts,.tsx --fix --no-error-on-unmatched-pattern src"
  },
  "dependencies": {
    "@aws/threat-composer": "0.0.0",
    "@cloudscape-design/components": "3.0.956",
    "@cloudscape-design/design-tokens": "3.0.56",
    "@cloudscape-design/global-styles": "1.0.42",
    "@emotion/react": "11.14.0",
    "docx": "8.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "remark-frontmatter": "^4",
    "remark-gfm": "^3",
    "remark-parse": "^10",
    "unified": "^10",
    "unist-util-visit": "5.0.0",
    "web-vitals": "3.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "5.17.0",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/mdast": "^3.0.15",
    "@types/node": "^20",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "^8",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.31.0",
    "jsdom": "^25.0.1",
    "typescript": "5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.4",
    "workbox-build": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "resolutions": {
    "@types/express-serve-static-core": "4.17.30",
    "@types/express": "4.17.13"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie 11",
      "not chrome < 51",
      "not safari < 10",
      "not android < 51"
    ],
    "development": [
      ">0.2%",
      "not dead",
      "not ie 11",
      "not chrome < 51",
      "not safari < 10",
      "not android < 51"
    ]
  }
}
