{
  "name": "@aws/threat-composer-app",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf build coverage test-reports dev-dist",
    "dev": "vite",
    "preview": "vite preview",
    "compile:website": "vite build",
    "compile:browser-extension": "vite build --mode browser-extension",
    "compile:ide-extension": "vite build --mode ide-extension",
    "compile": "yarn compile:website && yarn compile:browser-extension && yarn compile:ide-extension",
    "post-compile": "mkdir -p ./build/storybook && cp -r ../threat-composer/storybook.out/. ./build/storybook/",
    "build": "yarn compile && yarn post-compile && yarn test",
    "typecheck": "tsc6 --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "eslint": "eslint --fix --no-error-on-unmatched-pattern src eslint.config.mjs"
  },
  "dependencies": {
    "@aws/threat-composer": "0.0.0",
    "@cloudscape-design/components": "3.0.1352",
    "@cloudscape-design/design-tokens": "3.0.108",
    "@cloudscape-design/global-styles": "1.0.67",
    "@emotion/react": "11.14.0",
    "docx": "9.7.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "remark-frontmatter": "^5",
    "remark-gfm": "^4",
    "remark-parse": "^11",
    "unified": "^11",
    "unist-util-visit": "5.1.0",
    "web-vitals": "6.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "^10",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jsdom": "^30.0.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "resolutions": {
    "@types/express-serve-static-core": "4.17.30",
    "@types/express": "4.17.13"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie 11",
      "not chrome < 51",
      "not safari < 10",
      "not android < 51"
    ],
    "development": [
      ">0.2%",
      "not dead",
      "not ie 11",
      "not chrome < 51",
      "not safari < 10",
      "not android < 51"
    ]
  }
}
