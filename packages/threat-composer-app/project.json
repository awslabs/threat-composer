{
  "name": "@aws/threat-composer-app",
  "root": "packages/threat-composer-app",
  "sourceRoot": "packages/threat-composer-app/src",
  "projectType": "application",
  "implicitDependencies": [
    "@aws/threat-composer"
  ],
  "targets": {
    "clean": {
      "command": "rm -rf build coverage test-reports",
      "options": {
        "cwd": "packages/threat-composer-app"
      }
    },
    "compile:website": {
      "command": "BUILD_PATH=./build/website/ craco build",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        "clean",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        {
          "env": "REACT_APP_ROUTE_BASE_PATH"
        },
        {
          "env": "REACT_APP_GITHUB_PAGES"
        },
        {
          "env": "PUBLIC_URL"
        }
      ],
      "outputs": [
        "{projectRoot}/build/website"
      ],
      "cache": true
    },
    "compile:browser-extension": {
      "command": "INLINE_RUNTIME_CHUNK=false BUILD_PATH=./build/browser-extension/ REACT_APP_APP_MODE=browser-extension craco build",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        "clean",
        "^build"
      ],
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [
        "{projectRoot}/build/browser-extension"
      ],
      "cache": true
    },
    "compile:ide-extension": {
      "command": "INLINE_RUNTIME_CHUNK=false BUILD_PATH=./build/ide-extension/ REACT_APP_APP_MODE=ide-extension craco build",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        "clean",
        "^build"
      ],
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [
        "{projectRoot}/build/ide-extension"
      ],
      "cache": true
    },
    "compile": {
      "executor": "nx:noop",
      "dependsOn": [
        "compile:website",
        "compile:browser-extension",
        "compile:ide-extension"
      ]
    },
    "copy-storybook": {
      "command": "mkdir -p ./build/storybook && cp -r ../threat-composer/storybook.out/ ./build/storybook/",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        "clean",
        {
          "projects": [
            "@aws/threat-composer"
          ],
          "target": "storybook:build"
        }
      ],
      "inputs": [
        "{workspaceRoot}/packages/threat-composer/storybook.out/**/*"
      ],
      "outputs": [
        "{projectRoot}/build/storybook"
      ],
      "cache": true
    },
    "eslint": {
      "command": "eslint --ext .ts,.tsx --fix --no-error-on-unmatched-pattern src test build-tools",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        {
          "projects": [
            "@aws/threat-composer"
          ],
          "target": "compile"
        }
      ]
    },
    "test": {
      "command": "craco test --watchAll=false --passWithNoTests",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        {
          "projects": [
            "@aws/threat-composer"
          ],
          "target": "copy-assets"
        }
      ]
    },
    "build": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build",
        "compile",
        "copy-storybook",
        "eslint",
        "test"
      ]
    },
    "dev": {
      "command": "craco start",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        {
          "projects": [
            "@aws/threat-composer"
          ],
          "target": "copy-assets"
        }
      ],
      "cache": false
    },
    "watch": {
      "command": "tsc --build -w",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "cache": false
    }
  }
}
