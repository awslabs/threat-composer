{
  "name": "@aws/threat-composer-app",
  "root": "packages/threat-composer-app",
  "targets": {
    "pre-compile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task pre-compile",
        "cwd": "packages/threat-composer-app"
      }
    },
    "compile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task compile",
        "cwd": "packages/threat-composer-app"
      }
    },
    "post-compile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task post-compile",
        "cwd": "packages/threat-composer-app"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task test",
        "cwd": "packages/threat-composer-app"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task package",
        "cwd": "packages/threat-composer-app"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task build",
        "cwd": "packages/threat-composer-app"
      }
    },
    "post-upgrade": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task post-upgrade",
        "cwd": "packages/threat-composer-app"
      }
    },
    "upgrade": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task upgrade",
        "cwd": "packages/threat-composer-app"
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task watch",
        "cwd": "packages/threat-composer-app"
      }
    },
    "eslint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task eslint",
        "cwd": "packages/threat-composer-app"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task dev",
        "cwd": "packages/threat-composer-app"
      }
    },
    "compile:website": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task compile:website",
        "cwd": "packages/threat-composer-app"
      }
    },
    "compile:browser-extension": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task compile:browser-extension",
        "cwd": "packages/threat-composer-app"
      }
    },
    "compile:ide-extension": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task compile:ide-extension",
        "cwd": "packages/threat-composer-app"
      }
    }
  },
  "implicitDependencies": [
    "@aws/threat-composer"
  ]
}
