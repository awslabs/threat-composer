{
  "name": "@aws/threat-composer-app",
  "root": "packages/threat-composer-app",
  "sourceRoot": "packages/threat-composer-app/src",
  "projectType": "application",
  "implicitDependencies": [
    "@aws/threat-composer"
  ],
  "targets": {
    "clean": {
      "command": "rm -rf build coverage test-reports dev-dist",
      "options": {
        "cwd": "packages/threat-composer-app"
      }
    },
    "compile:website": {
      "command": "vite build",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        "clean",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        {
          "env": "VITE_ROUTE_BASE_PATH"
        },
        {
          "env": "VITE_GITHUB_PAGES"
        },
        {
          "env": "PUBLIC_URL"
        }
      ],
      "outputs": [
        "{projectRoot}/build/website"
      ],
      "cache": true
    },
    "compile:browser-extension": {
      "command": "vite build --mode browser-extension",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        "clean",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        {
          "env": "VITE_ROUTE_BASE_PATH"
        },
        {
          "env": "VITE_GITHUB_PAGES"
        },
        {
          "env": "PUBLIC_URL"
        }
      ],
      "outputs": [
        "{projectRoot}/build/browser-extension"
      ],
      "cache": true
    },
    "compile:ide-extension": {
      "command": "vite build --mode ide-extension",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        "clean",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        {
          "env": "VITE_ROUTE_BASE_PATH"
        },
        {
          "env": "VITE_GITHUB_PAGES"
        },
        {
          "env": "PUBLIC_URL"
        }
      ],
      "outputs": [
        "{projectRoot}/build/ide-extension"
      ],
      "cache": true
    },
    "compile": {
      "executor": "nx:noop",
      "dependsOn": [
        "compile:website",
        "compile:browser-extension",
        "compile:ide-extension"
      ]
    },
    "copy-storybook": {
      "command": "mkdir -p ./build/storybook && cp -r ../threat-composer/storybook.out/. ./build/storybook/",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        "clean",
        {
          "projects": [
            "@aws/threat-composer"
          ],
          "target": "storybook:build"
        }
      ],
      "inputs": [
        "{workspaceRoot}/packages/threat-composer/storybook.out/**/*"
      ],
      "outputs": [
        "{projectRoot}/build/storybook"
      ],
      "cache": true
    },
    "eslint": {
      "command": "eslint --fix --no-error-on-unmatched-pattern src eslint.config.mjs",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        {
          "projects": [
            "@aws/threat-composer"
          ],
          "target": "compile"
        }
      ]
    },
    "test": {
      "command": "vitest run --passWithNoTests",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        {
          "projects": [
            "@aws/threat-composer"
          ],
          "target": "copy-assets"
        }
      ]
    },
    "build": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build",
        "compile",
        "copy-storybook",
        "typecheck",
        "eslint",
        "test"
      ]
    },
    "dev": {
      "command": "vite",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        {
          "projects": [
            "@aws/threat-composer"
          ],
          "target": "copy-assets"
        }
      ],
      "cache": false
    },
    "typecheck": {
      "command": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        {
          "projects": [
            "@aws/threat-composer"
          ],
          "target": "compile"
        }
      ],
      "inputs": [
        "default",
        "^default"
      ],
      "cache": true
    },
    "test:watch": {
      "command": "vitest",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "cache": false
    },
    "preview": {
      "command": "vite preview",
      "options": {
        "cwd": "packages/threat-composer-app"
      },
      "dependsOn": [
        "compile:website"
      ],
      "cache": false
    }
  }
}
