{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "es2020",
      "esnext"
    ],
    "module": "ESNext",
    // Node10 resolution, not "bundler": several Cloudscape type-only imports
    // reach subpaths (internal/events, input/interfaces) that are absent from
    // that package's "exports" map. They are erased at compile time, so they
    // never need to resolve at runtime.
    //
    // Re-verified against Cloudscape 3.0.1350: switching to "bundler" still
    // produces 21 TS2307 "Cannot find module
    // '@cloudscape-design/components/internal/events'" errors plus ~19 cascading
    // implicit-any errors, so the exports map has not been fixed upstream.
    //
    // TypeScript 6 deprecates node10 and TypeScript 7 REMOVES it, which is why
    // this package cannot go to TS 7 until either Cloudscape publishes those
    // subpaths or the internal type imports are replaced with local equivalents.
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "declaration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "alwaysStrict": true,
    "strict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "stripInternal": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "skipLibCheck": true,
    "noEmitOnError": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.stories.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
