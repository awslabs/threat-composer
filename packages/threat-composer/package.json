{
  "name": "@aws/threat-composer",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "rm -rf lib dist coverage test-reports storybook.out tsconfig.tsbuildinfo",
    "compile": "tsc -p tsconfig.json",
    "copy-assets": "rsync -a --prune-empty-dirs --include='*/' --include='*.css' --include='*.png' --include='*.gif' --exclude='*' ./src/ ./lib/",
    "build": "yarn clean && yarn compile && yarn copy-assets && yarn storybook:build && yarn test",
    "typecheck": "tsc --noEmit -p tsconfig.dev.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eslint": "eslint --ext .ts,.tsx --fix --no-error-on-unmatched-pattern src",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook.out",
    "package": "mkdir -p dist/js && npm pack --pack-destination dist/js"
  },
  "dependencies": {
    "@aws-northstar/ui": "1.4.2",
    "@cloudscape-design/board-components": "3.0.101",
    "@cloudscape-design/collection-hooks": "1.0.73",
    "@cloudscape-design/components": "3.0.956",
    "@cloudscape-design/design-tokens": "3.0.56",
    "@cloudscape-design/global-styles": "1.0.42",
    "@emotion/react": "11.14.0",
    "@mdxeditor/editor": "^3.27",
    "browser-image-compression": "2.0.2",
    "indefinite": "2.5.1",
    "react-markdown": "8.0.7",
    "react-simply-carousel": "9.1.10",
    "rehype-raw": "6.1.1",
    "rehype-stringify": "9.0.4",
    "remark-frontmatter": "4.0.1",
    "remark-gfm": "3.0.1",
    "remark-parse": "10.0.2",
    "remark-rehype": "10.1.0",
    "sanitize-html": "2.16.0",
    "unified": "10.1.2",
    "use-local-storage-state": "18.3.3",
    "uuid": "14.0.0",
    "yaml": "2.8.3",
    "zod": "^4"
  },
  "peerDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/indefinite": "2.3.4",
    "@types/node": "^20",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.7",
    "@types/sanitize-html": "2.15.0",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "@vitejs/plugin-react": "4.4.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.31.0",
    "jsdom": "^25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "^8.6.14",
    "typescript": "5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie 11",
      "not chrome < 51",
      "not safari < 10",
      "not android < 51"
    ],
    "development": [
      ">0.2%",
      "not dead",
      "not ie 11",
