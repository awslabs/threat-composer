{
  "name": "@aws/threat-composer",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "rm -rf lib dist coverage test-reports storybook.out tsconfig.tsbuildinfo",
    "compile": "tsc6 -p tsconfig.json",
    "copy-assets": "rsync -a --prune-empty-dirs --include='*/' --include='*.css' --include='*.png' --include='*.gif' --exclude='*' ./src/ ./lib/",
    "build": "yarn clean && yarn compile && yarn copy-assets && yarn storybook:build && yarn test",
    "typecheck": "tsc6 --noEmit -p tsconfig.dev.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eslint": "eslint --fix --no-error-on-unmatched-pattern src eslint.config.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook.out",
    "package": "mkdir -p dist/js && npm pack --pack-destination dist/js"
  },
  "dependencies": {
    "@aws-northstar/ui": "1.4.2",
    "@cloudscape-design/board-components": "3.0.220",
    "@cloudscape-design/collection-hooks": "1.0.107",
    "@cloudscape-design/components": "3.0.1352",
    "@cloudscape-design/design-tokens": "3.0.108",
    "@cloudscape-design/global-styles": "1.0.67",
    "@emotion/react": "11.14.0",
    "@mdxeditor/editor": "^4.2",
    "browser-image-compression": "2.0.2",
    "indefinite": "2.5.2",
    "react-markdown": "10.1.0",
    "react-simply-carousel": "10.0.5",
    "rehype-raw": "7.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sanitize-html": "2.17.7",
    "unified": "11.0.5",
    "use-local-storage-state": "20.0.0",
    "uuid": "14.0.2",
    "yaml": "2.9.0",
    "zod": "^4"
  },
  "peerDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@types/indefinite": "2.3.4",
    "@types/node": "^26",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/sanitize-html": "2.16.1",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jsdom": "^30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "^8.6.18",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie 11",
      "not chrome < 51",
      "not safari < 10",
      "not android < 51"
    ],
    "development": [
      ">0.2%",
      "not dead",
      "not ie 11",
      "not chrome < 51",
      "not safari < 10",
      "not android < 51"
    ]
  }
}
