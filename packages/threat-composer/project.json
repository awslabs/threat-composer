{
  "name": "@aws/threat-composer",
  "root": "packages/threat-composer",
  "sourceRoot": "packages/threat-composer/src",
  "projectType": "library",
  "targets": {
    "clean": {
      "command": "rm -rf lib dist storybook.out coverage test-reports tsconfig.tsbuildinfo",
      "options": {
        "cwd": "packages/threat-composer"
      }
    },
    "compile": {
      "command": "tsc --build",
      "options": {
        "cwd": "packages/threat-composer"
      },
      "dependsOn": [
        "clean",
        {
          "projects": [
            "@aws/threat-composer-monorepo"
          ],
          "target": "build:packs"
        }
      ],
      "outputs": [
        "{projectRoot}/lib"
      ]
    },
    "copy-assets": {
      "command": "rsync -ar --prune-empty-dirs --include='*/' --include='*.css' --include='*.png' --include='*.gif' --exclude='*' ./src/ ./lib/",
      "options": {
        "cwd": "packages/threat-composer"
      },
      "dependsOn": [
        "compile"
      ],
      "inputs": [
        "{projectRoot}/src/**/*.css",
        "{projectRoot}/src/**/*.png",
        "{projectRoot}/src/**/*.gif"
      ],
      "outputs": [
        "{projectRoot}/lib/**/*.css",
        "{projectRoot}/lib/**/*.png",
        "{projectRoot}/lib/**/*.gif"
      ],
      "cache": true
    },
    "storybook:build": {
      "command": "storybook build -o storybook.out",
      "options": {
        "cwd": "packages/threat-composer"
      },
      "dependsOn": [
        "clean"
      ],
      "inputs": [
        "default"
      ],
      "outputs": [
        "{projectRoot}/storybook.out"
      ],
      "cache": true
    },
    "eslint": {
      "command": "eslint --ext .ts,.tsx --fix --no-error-on-unmatched-pattern src test build-tools",
      "options": {
        "cwd": "packages/threat-composer"
      }
    },
    "test": {
      "command": "jest --passWithNoTests --updateSnapshot",
      "options": {
        "cwd": "packages/threat-composer"
      },
      "dependsOn": []
    },
    "package": {
      "command": "mkdir -p dist/js && npm pack --pack-destination dist/js",
      "options": {
        "cwd": "packages/threat-composer"
      },
      "dependsOn": [
        "copy-assets"
      ]
    },
    "build": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build",
        "compile",
        "copy-assets",
        "storybook:build",
        "eslint",
        "test",
        "package"
      ]
    },
    "storybook": {
      "command": "storybook dev -p 6006",
      "options": {
        "cwd": "packages/threat-composer"
      },
      "cache": false
    },
    "test:watch": {
      "command": "jest --watch",
      "options": {
        "cwd": "packages/threat-composer"
      },
      "cache": false
    },
    "watch": {
      "command": "tsc --build -w",
      "options": {
        "cwd": "packages/threat-composer"
      },
      "cache": false
    }
  }
}
