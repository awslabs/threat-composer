{
  "name": "@aws/threat-composer",
  "root": "packages/threat-composer",
  "targets": {
    "pre-compile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task pre-compile",
        "cwd": "packages/threat-composer"
      }
    },
    "compile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task compile",
        "cwd": "packages/threat-composer"
      }
    },
    "post-compile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task post-compile",
        "cwd": "packages/threat-composer"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task test",
        "cwd": "packages/threat-composer"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task package",
        "cwd": "packages/threat-composer"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task build",
        "cwd": "packages/threat-composer"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task test:watch",
        "cwd": "packages/threat-composer"
      }
    },
    "post-upgrade": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task post-upgrade",
        "cwd": "packages/threat-composer"
      }
    },
    "upgrade": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task upgrade",
        "cwd": "packages/threat-composer"
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task watch",
        "cwd": "packages/threat-composer"
      }
    },
    "eslint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task eslint",
        "cwd": "packages/threat-composer"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task storybook",
        "cwd": "packages/threat-composer"
      }
    },
    "storybook:build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/run-task storybook:build",
        "cwd": "packages/threat-composer"
      }
    }
  }
}
