{
  "name": "@aws/threat-composer-app-browser-extension",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf .output .wxt coverage test-reports",
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "compile": "wxt build -b chrome && wxt build -b firefox",
    "build": "yarn compile && yarn test",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eslint": "eslint --ext .ts,.tsx --fix --no-error-on-unmatched-pattern src"
  },
  "dependencies": {
    "@cloudscape-design/components": "3.0.956",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "@vitejs/plugin-react": "4.4.1",
    "@wxt-dev/auto-icons": "^1.1.0",
    "eslint": "^8",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.31.0",
    "jsdom": "^25.0.1",
    "rollup-plugin-copy": "3.5.0",
    "typescript": "5.8.3",
    "vitest": "^3.2.4",
    "wxt": "0.20.6"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie 11",
      "not chrome < 51",
      "not safari < 10",
      "not android < 51"
    ],
    "development": [
      ">0.2%",
      "not dead",
      "not ie 11",
      "not chrome < 51",
      "not safari < 10",
      "not android < 51"
    ]
  }
}
