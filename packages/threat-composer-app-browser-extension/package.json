{
  "name": "@aws/threat-composer-app-browser-extension",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf .output .wxt coverage test-reports",
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "compile": "wxt build -b chrome && wxt build -b firefox",
    "build": "yarn compile && yarn test",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eslint": "eslint --fix --no-error-on-unmatched-pattern src eslint.config.mjs"
  },
  "dependencies": {
    "@cloudscape-design/components": "3.0.1352",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^26",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-react": "6.1.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "jsdom": "^30.0.1",
    "rollup-plugin-copy": "3.5.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.11",
    "wxt": "0.21.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie 11",
      "not chrome < 51",
      "not safari < 10",
      "not android < 51"
    ],
    "development": [
      ">0.2%",
      "not dead",
      "not ie 11",
      "not chrome < 51",
      "not safari < 10",
      "not android < 51"
    ]
  }
}
