{
  "name": "@aws/threat-composer-app-browser-extension",
  "root": "packages/threat-composer-app-browser-extension",
  "sourceRoot": "packages/threat-composer-app-browser-extension/src",
  "projectType": "application",
  "implicitDependencies": [
    "@aws/threat-composer-app"
  ],
  "targets": {
    "clean": {
      "command": "rm -rf .output dist coverage test-reports",
      "options": {
        "cwd": "packages/threat-composer-app-browser-extension"
      }
    },
    "compile:chrome": {
      "command": "wxt build -b chrome",
      "options": {
        "cwd": "packages/threat-composer-app-browser-extension"
      },
      "dependsOn": [
        "clean",
        {
          "projects": [
            "@aws/threat-composer-app"
          ],
          "target": "compile:browser-extension"
        }
      ],
      "inputs": [
        "default",
        "{workspaceRoot}/packages/threat-composer-app/build/browser-extension/**/*",
        "{workspaceRoot}/packages/threat-composer-app/src/assets/logo-dark.svg"
      ],
      "outputs": [
        "{projectRoot}/.output/chrome-mv3"
      ],
      "cache": true
    },
    "compile:firefox": {
      "command": "wxt build -b firefox",
      "options": {
        "cwd": "packages/threat-composer-app-browser-extension"
      },
      "dependsOn": [
        "clean",
        "compile:chrome"
      ],
      "inputs": [
        "default",
        "{workspaceRoot}/packages/threat-composer-app/build/browser-extension/**/*",
        "{workspaceRoot}/packages/threat-composer-app/src/assets/logo-dark.svg"
      ],
      "outputs": [
        "{projectRoot}/.output/firefox-mv2"
      ],
      "cache": true
    },
    "compile": {
      "executor": "nx:noop",
      "dependsOn": [
        "compile:chrome",
        "compile:firefox"
      ]
    },
    "eslint": {
      "command": "eslint --ext .ts,.tsx --fix --no-error-on-unmatched-pattern src test build-tools",
      "options": {
        "cwd": "packages/threat-composer-app-browser-extension"
      }
    },
    "test": {
      "command": "jest --passWithNoTests --updateSnapshot",
      "options": {
        "cwd": "packages/threat-composer-app-browser-extension"
      },
      "dependsOn": []
    },
    "package": {
      "command": "mkdir -p dist/js && npm pack --pack-destination dist/js",
      "options": {
        "cwd": "packages/threat-composer-app-browser-extension"
      },
      "dependsOn": [
        "compile"
      ]
    },
    "build": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build",
        "compile",
        "eslint",
        "test",
        "package"
      ]
    },
    "zip": {
      "command": "wxt zip",
      "options": {
        "cwd": "packages/threat-composer-app-browser-extension"
      },
      "dependsOn": [
        "compile:chrome"
      ],
      "cache": false
    },
    "zip:firefox": {
      "command": "wxt zip --browser firefox",
      "options": {
        "cwd": "packages/threat-composer-app-browser-extension"
      },
      "dependsOn": [
        "compile:firefox"
      ],
      "cache": false
    },
    "dev": {
      "command": "wxt",
      "options": {
        "cwd": "packages/threat-composer-app-browser-extension"
      },
      "dependsOn": [
        {
          "projects": [
            "@aws/threat-composer-app"
          ],
          "target": "compile:browser-extension"
        }
      ],
      "cache": false
    },
    "dev:firefox": {
      "command": "wxt --browser firefox",
      "options": {
        "cwd": "packages/threat-composer-app-browser-extension"
      },
      "dependsOn": [
        {
          "projects": [
            "@aws/threat-composer-app"
          ],
          "target": "compile:browser-extension"
        }
      ],
      "cache": false
    },
    "watch": {
      "command": "tsc --build -w",
      "options": {
        "cwd": "packages/threat-composer-app-browser-extension"
      },
      "cache": false
    }
  }
}
