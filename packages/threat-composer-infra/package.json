{
  "name": "@aws/threat-composer-infra",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf cdk.out lib coverage test-reports",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "synth": "cdk synth",
    "synth:silent": "cdk synth -q",
    "build": "yarn typecheck && yarn test && yarn synth:silent",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "diff": "cdk diff",
    "watch": "cdk deploy --hotswap && cdk watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "eslint": "eslint --ext .ts --fix --no-error-on-unmatched-pattern src test"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.194.0",
    "cdk-nag": "2.35.88",
    "constructs": "^10.0.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "aws-cdk": "^2.194.0",
    "eslint": "^8",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.31.0",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "vitest": "^3.2.4"
  }
}
