{
  "name": "@aws/threat-composer-infra",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf cdk.out lib coverage test-reports",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "synth": "cdk synth",
    "synth:silent": "cdk synth -q",
    "build": "yarn typecheck && yarn test && yarn synth:silent",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "diff": "cdk diff",
    "watch": "cdk deploy --hotswap && cdk watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "eslint": "eslint --fix --no-error-on-unmatched-pattern src test eslint.config.mjs"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.266.0",
    "cdk-nag": "^2",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@typescript/native": "npm:typescript@7.0.2",
    "aws-cdk": "^2.1138.0",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "tsx": "4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.11"
  }
}
