{
  "name": "@aws/threat-composer-infra",
  "root": "packages/threat-composer-infra",
  "sourceRoot": "packages/threat-composer-infra/src",
  "projectType": "application",
  "implicitDependencies": [
    "@aws/threat-composer-app"
  ],
  "targets": {
    "clean": {
      "command": "rm -rf cdk.out coverage test-reports",
      "options": {
        "cwd": "packages/threat-composer-infra"
      }
    },
    "synth": {
      "command": "cdk synth -q",
      "options": {
        "cwd": "packages/threat-composer-infra"
      },
      "dependsOn": [
        "clean",
        "^build"
      ],
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [
        "{projectRoot}/cdk.out"
      ],
      "cache": true
    },
    "eslint": {
      "command": "eslint --ext .ts,.tsx --fix --no-error-on-unmatched-pattern src test build-tools",
      "options": {
        "cwd": "packages/threat-composer-infra"
      }
    },
    "test": {
      "command": "jest --passWithNoTests --updateSnapshot",
      "options": {
        "cwd": "packages/threat-composer-infra"
      }
    },
    "build": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build",
        "synth",
        "eslint",
        "test"
      ]
    },
    "diff": {
      "command": "cdk diff",
      "options": {
        "cwd": "packages/threat-composer-infra"
      },
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "deploy": {
      "command": "cdk deploy",
      "options": {
        "cwd": "packages/threat-composer-infra"
      },
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "destroy": {
      "command": "cdk destroy",
      "options": {
        "cwd": "packages/threat-composer-infra"
      },
      "cache": false
    },
    "watch": {
      "command": "cdk deploy --hotswap && cdk watch",
      "options": {
        "cwd": "packages/threat-composer-infra"
      },
      "cache": false
    },
    "test:watch": {
      "command": "jest --watch",
      "options": {
        "cwd": "packages/threat-composer-infra"
      },
      "cache": false
    }
  }
}
