{
  "app": "npx ts-node -P tsconfig.json --prefer-ts-exts src/pipeline.ts",
  "requireApproval": "never",
  "output": "cdk.out",
  "watch": {
    "include": [
      "src/**/*.ts",
      "test/**/*.ts"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "pnpm-lock.yaml",
      "node_modules"
    ]
  }
}
