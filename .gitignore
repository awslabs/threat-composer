# Build output of the workspace packages
packages/*/lib/

# nx local state, all machine-local and rebuilt on demand: the project graph,
# file map, daemon state and (on nx 21+) the SQLite task cache all live under
# .nx/workspace-data, with .nx/cache the pre-21 location. Ignored as a whole
# rather than path by path, so a future nx version writing somewhere new cannot
# start committing build artifacts. Plugins are the one thing here meant to be
# shared, so they stay eligible.
#
# nx.json is configuration, lives at the repo root, and IS committed. So is
# pnpm-lock.yaml.
.nx/*
!.nx/plugins

# pnpm only uses a local store when store-dir is overridden, but ignore it so a
# developer who does override it cannot commit it by accident.
.pnpm-store/
packages/*/dist/
packages/*/build/

# Python (packages/threat-composer-ai)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.coverage
.env
.venv/
venv/

# Vite mode files that select which artifact is built. These are configuration,
# not secrets, and are intentionally committed -- without them the
# browser-extension and ide-extension builds lose VITE_APP_MODE.
# The `.env` rule above matches that exact filename only, so it does not catch
# them. If an env rule is ever broadened (`.env*`), these negations must be
# moved below it: git applies the last matching pattern.
!packages/threat-composer-app/.env.browser-extension
!packages/threat-composer-app/.env.ide-extension
