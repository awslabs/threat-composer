{
  "name": "@aws/threat-composer-monorepo",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/threat-composer",
      "packages/threat-composer-app",
      "packages/threat-composer-app-browser-extension",
      "packages/threat-composer-infra"
    ],
    "nohoist": [
      "**/wxt"
    ]
  },
  "scripts": {
    "build": "yarn build:packs && yarn build:workspaces && yarn build:schema",
    "build:workspaces": "yarn workspace @aws/threat-composer run build && yarn workspace @aws/threat-composer-app run build && yarn workspace @aws/threat-composer-app-browser-extension run build && yarn workspace @aws/threat-composer-infra run build",
    "build:packs": "tsx ./scripts/data/buildPacks.ts ThreatPack && tsx ./scripts/data/buildPacks.ts MitigationPack",
    "build:schema": "tsx ./scripts/generateSchema.ts",
    "clean": "yarn workspaces run clean",
    "dev": "yarn workspace @aws/threat-composer-app run dev",
    "dev:extension": "yarn workspace @aws/threat-composer-app-browser-extension run dev",
    "eslint": "yarn workspaces run eslint",
    "knip": "knip",
    "export:examples": "yarn build && tsx ./scripts/exportExamples.ts",
    "generate:attribution": "git secrets --scan && generate-attribution && mv oss-attribution/attribution.txt LICENSE-THIRD-PARTY",
    "license:checker": "yarn license-checker --summary --production --excludePrivatePackages --onlyAllow 'MIT;Apache-2.0;ISC;'",
    "ai:cli": "uv run --project packages/threat-composer-ai threat-composer-ai-cli",
    "ai:lint": "cd packages/threat-composer-ai && uv run ruff check . && uv run ruff format --check .",
    "ai:test": "cd packages/threat-composer-ai && uv run pytest tests/",
    "postinstall": "command -v uv > /dev/null && (cd packages/threat-composer-ai && uv sync) || echo 'uv not found on PATH; skipping packages/threat-composer-ai sync'",
    "prepare": "husky install",
    "storybook": "yarn workspace @aws/threat-composer run storybook",
    "test": "yarn workspaces run test",
    "typecheck": "yarn workspaces run typecheck",
    "upgrade-deps": "yarn npm-check-updates --deep --rejectVersion 0.0.0 -u --dep prod,dev,peer,optional --target=minor && rm -f yarn.lock && yarn install"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "eslint": "^8",
    "eslint-config-prettier": "8.10.0",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-header": "3.1.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "4.2.1",
    "husky": "8.0.3",
    "knip": "^5.64.4",
    "license-checker": "25.0.1",
    "npm-check-updates": "17.1.18",
    "prettier": "2.8.8",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "zod": "^4"
  },
  "resolutions": {
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^6.3.5",
    "nth-check": "^2.1.1",
    "yaml": "^2.2.2",
    "js-yaml": "^3.14.2",
    "semver": "^7.5.3",
    "@babel/traverse": "^7.25.0",
    "postcss": "^8.4.31",
    "esbuild": "^0.25.4",
    "tar": "^7.5.9",
    "lodash": "^4.18.0",
    "qs": "^6.15.0"
  },
  "engines": {
    "node": ">=20",
    "yarn": ">=1 <2"
  }
}
