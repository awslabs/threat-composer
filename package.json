{
  "name": "@aws/threat-composer-monorepo",
  "scripts": {
    "ai:cli": "uv run --project packages/threat-composer-ai threat-composer-ai-cli",
    "build": "nx run-many -t build --nx-bail",
    "build:packs": "nx run @aws/threat-composer-monorepo:build:packs",
    "build:schema": "nx run @aws/threat-composer-monorepo:build:schema",
    "clean": "nx run-many -t clean",
    "dev": "nx run @aws/threat-composer-app:dev",
    "dev:extension": "nx run @aws/threat-composer-app-browser-extension:dev",
    "e2e": "nx run @aws/threat-composer-e2e:e2e",
    "e2e:all": "nx run @aws/threat-composer-e2e:e2e:all",
    "e2e:extension": "nx run @aws/threat-composer-e2e:e2e:extension",
    "e2e:install-browsers": "nx run @aws/threat-composer-e2e:install-browsers",
    "e2e:preview": "nx run @aws/threat-composer-e2e:e2e:preview",
    "e2e:ui": "nx run @aws/threat-composer-e2e:e2e:ui",
    "e2e:variants": "nx run @aws/threat-composer-e2e:e2e:variants",
    "eslint": "nx run-many -t eslint --nx-bail",
    "export:examples": "nx run @aws/threat-composer-monorepo:export:examples",
    "generate:attribution": "nx run @aws/threat-composer-monorepo:generate:attribution",
    "graph": "nx graph",
    "license:checker": "nx run @aws/threat-composer-monorepo:license:checker",
    "lint": "nx run-many -t eslint lint --nx-bail",
    "postinstall": "NX_DAEMON=false nx run threat-composer-ai:install",
    "prepare": "husky",
    "storybook": "nx run @aws/threat-composer:storybook",
    "test": "nx run-many -t test --nx-bail",
    "typecheck": "nx run-many -t typecheck --nx-bail",
    "upgrade-deps": "npm-check-updates --deep --rejectVersion 0.0.0 -u --dep prod,dev,peer,optional --target=minor && rm -f pnpm-lock.yaml && pnpm install"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tony.ganchev/eslint-plugin-header": "^3.4.4",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^10",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "license-checker": "25.0.1",
    "npm-check-updates": "23.1.0",
    "nx": "^23",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "^6.0.3",
    "zod": "^4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@swc/core",
      "core-js",
      "core-js-pure",
      "es5-ext",
      "nx",
      "sharp",
      "spawn-sync",
      "unrs-resolver"
    ],
    "overrides": {
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "vite": "^8.2.2",
      "@cloudscape-design/component-toolkit": "^1.0.0-beta.179",
      "nth-check": "^2.1.1",
      "yaml": "^2.2.2",
      "js-yaml": "^4.3.0",
      "semver": "^7.5.3",
      "@babel/traverse": "^7.25.0",
      "postcss": "^8.5.26",
      "esbuild": "^0.28.0",
      "tar": "^7.5.22",
      "lodash": "^4.18.0",
      "qs": "^6.15.2",
      "fast-uri": "^3.1.6",
      "brace-expansion@>=5": "^5.0.9"
    }
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "pnpm": ">=10"
  },
  "license": "Apache-2.0",
  "version": "0.0.0",
  "private": true,
  "nx": {
    "includedScripts": []
  }
}
