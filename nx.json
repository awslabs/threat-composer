{
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.json"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"],
      "outputs": [
        "{projectRoot}/lib",
        "{projectRoot}/build",
        "{projectRoot}/dist",
        "{projectRoot}/.output",
        "{projectRoot}/storybook.out",
        "{projectRoot}/cdk.out",
        "{projectRoot}/coverage",
        "{projectRoot}/test-reports"
      ],
      "cache": true
    },
    "compile": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"],
      "outputs": [
        "{projectRoot}/lib",
        "{projectRoot}/build",
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"],
      "cache": true
    },
    "eslint": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"],
      "outputs": [
        "{projectRoot}/coverage",
        "{projectRoot}/test-reports"
      ],
      "cache": true
    },
    "lint": {
      "inputs": ["default"],
      "cache": true
    }
  }
}
