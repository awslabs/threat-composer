# Run ESLint on JavaScript/TypeScript packages, and on the e2e suite.
# `yarn eslint` is used rather than `yarn workspaces run eslint` so this matches
# what CI checks: e2e is a standalone package, not a workspace, so the workspaces
# form silently skips it.
yarn eslint

# Run Ruff on Python package - CHECK ONLY (no auto-fix)
# If checks fail, run manually: cd packages/threat-composer-ai && uv run ruff check . --fix && uv run ruff format .
cd packages/threat-composer-ai && \
  uv run ruff check . && \
  uv run ruff format --check .
